{% comment %}
  Minuit x TRMNL — séances de cinéma de Strasbourg
  Source: https://minuit.wyliam.fr (API publique, cache-first)
  Variable attendue: data = GET /api/v1/theater (JSON de la journée)
{% endcomment %}

{% assign base = 'https://minuit.wyliam.fr' %}

<style>
  /* Tout en sans-serif */
  .screen, .screen * { font-family: 'Inter', 'Helvetica Neue', Arial, sans-serif !important; }

  .mn-hero { display: flex; align-items: center; gap: 16px; padding: 8px 0 10px; border-bottom: 2px solid #000; }
  .mn-poster img { width: 110px; height: 165px; object-fit: cover; border: 2px solid #000; }
  .mn-hero-info { flex: 1; }
  .mn-hero-date { font-size: 28px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.02em; }
  .mn-film-pick { font-size: 13px; font-weight: 600; color: #fff; background: #1a1a1a; display: inline-block; padding: 2px 8px; }
  .mn-pick-title { font-size: 24px; font-weight: 700; line-height: 1.1; margin: 4px 0; text-transform: uppercase; }
  .mn-pick-times { font-size: 18px; font-weight: 600; }

  .mn-row {
    display: flex; justify-content: space-between; align-items: baseline;
    border-bottom: 1px solid #999; padding: 3px 0; font-size: 14px;
  }
  .mn-title { font-weight: 700; text-transform: uppercase; }
  .mn-times { font-weight: 500; white-space: nowrap; }
  .mn-theater { background: #1a1a1a; color: #fff; padding: 2px 10px; font-weight: 700; font-size: 13px; letter-spacing: 0.05em; text-transform: uppercase; display: inline-block; margin-top: 4px; }
  .mn-foot { display: flex; justify-content: space-between; margin-top: 6px; font-size: 12px; color: #444; }
</style>

<div class="mn-wrap">
  {% comment %} Film vedette : premier film avec poster → brother affiché en hero {% endcomment %}
  {% assign featured = null %}
  {% assign ftimes = '' %}
  {% for theater in data.theaters %}
    {% for film in theater.films %}
      {% if featured == null and film.posterUrl and film.showtimes.size > 0 %}
        {% assign featured = film %}
        {% assign posteur = film.posterUrl %}
        {% assign ftimes = film.showtimes | map: 'time' | join: ' · ' %}
      {% endif %}
    {% endfor %}
  {% endfor %}

  <div class="mn-hero">
    {% if posteur %}
      <div class="mn-poster"><img src="{{ base }}{{ posteur }}" /></div>
    {% endif %}
    <div class="mn-hero-info">
      <span class="mn-film-pick">Séance vedette</span>
      <div class="mn-pick-title">{{ featured.title }}</div>
      <div class="mn-pick-times">{{ ftimes }}</div>
    </div>
  </div>

  <div class="mn-head" style="display:flex;justify-content:space-between;align-items:baseline;margin-top:6px;">
    <span style="font-size:16px;font-weight:700;">Toutes les séances</span>
    <span style="font-size:13px;color:#444;">{{ data.displayDate }}</span>
  </div>

  {% assign count = 0 %}
  {% for theater in data.theaters %}
    {% if theater.films.size > 0 %}
      <div class="mn-theater">{{ theater.name }}</div>
      {% for film in theater.films limit: 3 %}
        <div class="mn-row">
          <span><span class="mn-title">{{ film.title }}</span>{% if film.format %}<span class="mn-meta">· {{ film.format }}</span>{% endif %}</span>
          <span class="mn-times">
            {% for st in film.showtimes limit: 6 %}
              {{ st.time }}{% if st.isVost %}<sup>V</sup>{% endif %}{% if st.isPreview %}<sup>P</sup>{% endif %}{% unless forloop.last %} · {% endunless %}
            {% endfor %}
          </span>
        </div>
        {% assign count = count | plus: 1 %}
      {% endfor %}
    {% endif %}
  {% endfor %}

  <div class="mn-foot">
    <span>minuit.wyliam.fr</span>
    <span>{{ count }} films · toutes salles</span>
  </div>
</div>
